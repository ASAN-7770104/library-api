      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 404', function () { pm.response.to.have.status(404); });",
              "pm.test('error is Book not found', function () { pm.expect(pm.response.json().error).to.eql('Book not found'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/books/{{createdId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "books",
            "{{createdId}}"
          ]
        }
      }
    },
    {
